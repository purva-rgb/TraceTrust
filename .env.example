DATABASE_PATH=laptop_anti_counterfeit.db
JWT_SECRET=replace-with-a-32-byte-or-longer-random-secret
JWT_ISSUER=tracetrust
JWT_AUDIENCE=tracetrust-api
JWT_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEMO_MANUFACTURER_PASSWORD=at-least-12-characters
DEMO_DISTRIBUTOR_PASSWORD=at-least-12-characters
DEMO_RETAILER_PASSWORD=at-least-12-characters

# Organization private keys stay off-DB. Hex with 0x prefix, or a keystore JSON path.
# ORG_PRIVATE_KEY_MANUFACTURER=0x...
# ORG_PRIVATE_KEY_DISTRIBUTOR=0x...
# ORG_PRIVATE_KEY_RETAILER=0x...
# KEYSTORE_PATH=keystore.json
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# GOVERNANCE_PRIVATE_KEY=0x...
# DEPLOYMENT_ID=local-hardhat-v1
